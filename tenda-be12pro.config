# =========================================================
# Tenda BE12 Pro (BE7200 Ultra) 最终定稿 .config
# 目标：单路由承载 AdGuard Home + PassWall(Xray) + Tailscale/WireGuard + 全家桶
# 源码：padavanonly/immortalwrt-mt798x-6.6 @ openwrt-24.10-6.6
#
# 【闪存空间定论】本机 ubi/rootfs 分区 ≈ 90MB（OpenWrt 官方 PR#21461 flash layout：
#   0xd80000 – 0x6780000 ≈ 90MB）。本配置编译产物约 72~84MB，< 90MB → 不会 "Image too big"，
#   但建议控制在 ~85MB 以内留余量。刷完 overlay 余量仅 ~18MB（精简版约 60MB），
#   足够运行全家桶，不够再 opkg 装很多包。
# 【校验】make defconfig 后 grep 确认每个 =y 都还在；被丢弃=该包不在 feeds。
#   workflow 内置校验脚本，构建日志打印 OK / MISS。
# 【加速核心】联发科 HWNAT 硬件转发 = 内核模块 kmod-mediatek-hnat（已在下方硬件加速段显式开启，
#   它并不会被 fork “默认开启”——必须手动 =y，否则内核无法编译）。
#   刷入后在“网络→防火墙→通用设置”勾【Hardware Flow Offloading】即生效（千兆 NAT CPU 个位数）。
#   turboacc 只负责 BBR / FullCone GUI，切勿开其 SFE/软件 Flow Offload（与 HWNAT 冲突掉线）。
# =========================================================

CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_tenda_be12-pro=y

# ---------- LuCI 基座（必须有，否则刷完没网页）----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_LUCI_LANG_zh_Hans=y          # 简体中文（符号名即此，无需 i18n-*-zh-cn 单包）
# 默认主题 argon
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_DEFAULT_luci-theme-argon=y
# 注：luci-app-argon-config 已移除——它只是“主题设置”菜单（换壁纸/Logo/配色），
#     移除后 Argon 主题外观完全不变，只是不能再在网页后台自定义界面。

# ---------- 硬件加速（关键修正）----------
# ⚠️ 编译前提：联发科 HWNAT 内核模块必须显式开启！
#   padavanonly 的 mtk_eth_soc.c 无条件引用 mtk_hnat 头文件里的宏（HIT_BIND_FORCE_TO_CPU 等），
#   而该头文件的 #include 被 #ifdef CONFIG_NET_MEDIATEK_HNAT 包裹。
#   不开启 → include 被跳过 → 宏全部 undeclared → 内核编译失败（GitHub Actions 报 exit 2）。
#   此模块即 HWNAT 硬件转发的内核实现，正是你想要的加速，必须 =y。
CONFIG_PACKAGE_kmod-mediatek_hnat=y
# padavanonly 这个 MT798x 专用 fork 的 turboacc 叫 luci-app-turboacc-mtk（已适配 HWNAT/PPE）。
# 若你的 fork 只有通用版 luci-app-turboacc，把下面的 -mtk 改回 luci-app-turboacc 即可。
CONFIG_PACKAGE_luci-app-turboacc-mtk=y
# 软件分流类（与 HWNAT 冲突）——保持未选：
# CONFIG_PACKAGE_luci-app-turboacc-mtk_INCLUDE_OFFLOAD is not set
# CONFIG_PACKAGE_luci-app-turboacc-mtk_INCLUDE_SHORTCUT_FE is not set
# 仅开 BBR 拥塞控制（符号名下划线 BBR_CCA，非连字符）
CONFIG_PACKAGE_luci-app-turboacc-mtk_INCLUDE_BBR_CCA=y
# 注：BBR 在 diy-part2.sh 也已用 sysctl 兜底；FullCone NAT 本机默认即 NAT1（无需 turboacc 实现）。

# ---------- 科学上网 / 代理（PassWall，需 diy-part1.sh 加源）----------
# 砍掉 SingBox / Haproxy 以瘦身（Xray 已覆盖 VLESS/REALITY/Trojan/SS 等绝大多数节点）
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set

# ---------- 异地组网 / VPN ----------
CONFIG_PACKAGE_luci-app-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y     # 网页"网络→接口"下拉才看得到 WireGuard 选项
CONFIG_PACKAGE_wireguard-tools=y
# CONFIG_PACKAGE_kmod-wireguard is not set
#   ↑ WireGuard 自 6.6 内核起已并入主线，kmod-wireguard 包在 24.10 已被移除；
#     内核原生支持，无需此包。留空不影响功能（luci-app-wireguard + wireguard-tools 即可）。
CONFIG_PACKAGE_luci-app-tailscale=y
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_kmod-tun=y                  # tailscale 需要 tun 设备（filogic 多为内核内置，此行若被丢弃也无害）

# ---------- 去广告 AdGuard Home（编译进 squashfs 底层，比 overlay 省空间）----------
CONFIG_PACKAGE_luci-app-adguardhome=y

# ---------- 远程访问 / DDNS（Cloudflare 脚本在 24.10 默认 feeds，无需额外源）----------
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y  # Cloudflare（24.10 feeds 内，已定稿只留此项）
# 注：ddns-scripts-aliyun 已移除——仅当你域名 DNS 托管在阿里云时才需加回。
CONFIG_PACKAGE_luci-app-upnp=y            # UPnP 端口映射，提升 NAT 类型

# ---------- 系统维护 / 监控 ----------
# 注：luci-app-ramfree 已移除——它仅执行 `echo 3 > drop_caches`，
#     而 Linux 缓存本就可被内核自动回收，功能冗余；真正保稳定靠下面的“定时重启”。
# 定时重启改用系统原生 cron（移除 luci-app-scheduled-reboot 的 GUI 菜单）：
#   刷入后执行一次即可永久生效（示例：每周日 4:30 自动重启）：
#     echo '30 4 * * 0 /sbin/reboot' >> /etc/crontabs/root
#     /etc/init.d/cron enable && /etc/init.d/cron start
#   ⚠️ cron 按路由器“本地时区”触发：请先在 LuCI 系统→系统→时区 设为 Asia/Shanghai，
#      否则默认按 UTC，4:30 会变成北京时间 12:30 才重启（差 8 小时）。
#   cron 守护进程由下方 CONFIG_PACKAGE_cron 提供（替代被移除的 luci-app 依赖）。
CONFIG_PACKAGE_cron=y
CONFIG_PACKAGE_luci-app-wol=y             # 网络唤醒
CONFIG_PACKAGE_luci-app-ttyd=y            # 网页终端
# SFTP 文件传输：dropbear 默认只支持 scp、不支持 sftp。装此包即可让 WinSCP/FileZilla
# 以 SFTP 模式可视化传文件（仅数百 KB）。注意只装 sftp-server 二进制，别装完整 openssh-server
# （会和 dropbear 抢 22 端口且更重）。
CONFIG_PACKAGE_openssh-sftp-server=y

# ---------- 无线 / IPv6 / WAN 协议基础 ----------
# 用 wpad-openssl（完整加密，支持 WPA3/EAP）替代默认的 wpad-basic-mbedtls。
# 必须显式取消默认项，否则两个 wpad 提供方冲突会报 "multiple providers" 编译失败。
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_wpad-openssl=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_luci-proto-ppp=y          # PPPoE 拨号 GUI（国行光纤桥接拨号必需；自动拉 ppp / ppp-mod-pppoe）
CONFIG_PACKAGE_ca-certificates=y         # HTTPS 证书信任（AdGuard Home 拉规则 / Tailscale / PassWall 订阅必需）

# ---------- 黑名单：128MB 严禁（保障固件不臃肿）----------
# docker / samba4 / vsftpd / aria2 / qbittorrent / vlmcsd 一律不装

# 禁用 PassWall 默认勾选的 V2ray-Plugin 子选项（避免触发 Go 1.25.5 编译报错）
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set

# (可选) 禁用已淘汰的 ShadowsocksR-Libev 客户端子选项
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set

# 禁用非必要的 GeoView 查看工具（避免 Go 编译报错，完全不影响 PassWall 功能）
# CONFIG_PACKAGE_geoview is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_GeoView is not set
